    "# 13)---------- Máximo, mínimo e soma ----------\n",
    "\n",
    "my_list = [5, 2, 3, 1, 4]\n",
    "\n",
    "greatest = max(my_list)\n",
    "smallest = min(my_list)\n",
    "list_sum = sum(my_list)\n",
    "\n",
    "print(\"menor:\", smallest)\n",
    "print(\"maior:\", greatest)\n",
    "print(\"soma:\", list_sum)"
   ]
  }
