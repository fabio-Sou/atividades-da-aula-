   "source": [
    "alunos = int(input(\"Quantos alunos do curso? \"))\n",
    "tamanho_grupo = int(input(\"Tamanho do grupo desejado? \"))\n",
    "\n",
    "grupos = alunos // tamanho_grupo\n",
    "if alunos % tamanho_grupo != 0:\n",
    "    grupos += 1  # adiciona mais um grupo se sobrar alunos\n",
    "\n",
    "print(f\"Número de grupos formados: {grupos}\")"
   ]
  }
 ],
