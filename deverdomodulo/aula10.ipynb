   "source": [
    "from math import sqrt\n",
    "A = int(input(\"Valor de a: \"))\n",
    "B = int(input(\"Valor de b: \"))\n",
    "C = int(input(\"Valor de c: \"))\n",
    "\n",
    "M = ((B ** 2) + ((- 4 * A )* C))\n",
    "R1 = (- B + sqrt(M))/ (2 * A)\n",
    "R2 = (- B - sqrt(M))/ (2 * A)\n",
    "\n",
    "print(f\"As raízes são {R1} e {R2}\")"
   ]
  }
 ],
